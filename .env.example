# Copy to .env. Values here are for local development only.
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ops
DATABASE_URL=postgresql://ops:ops@postgres:5432/ops
# Any long random string; signs the session cookie.
SESSION_SECRET=change-me-locally
# Seed the demo dataset on first boot (users, teams, 20k items). Off by default; never on in production.
SEED_ON_BOOT=true
# Passwordless sign-in as any user, for local development and tests. Off by default; never on in production.
DEV_LOGIN=true
# Mark the session cookie Secure. Leave false on plain-HTTP localhost; true behind HTTPS.
COOKIE_SECURE=false
# Google sign-in. The OAuth client ID from Google Cloud; leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
# Emails that become admins the first time they sign in with Google, comma separated.
ADMIN_EMAILS=
# A public demo: any Google account gets in, demo accounts are protected, data resets nightly. Never for real data.
DEMO_MODE=false
# Pages allowed to send writes, comma separated.
ALLOWED_ORIGINS=http://localhost:5173
